{
  "name": "@kud/duux",
  "version": "0.4.0",
  "type": "module",
  "description": "Duux smart fan control library — passwordless auth, device discovery, and cloud/MQTT command transports for the Whisper Flex 2",
  "keywords": [
    "duux",
    "whisper-flex",
    "smart-fan",
    "cloudgarden",
    "home-automation"
  ],
  "license": "MIT",
  "author": "Erwann Mest <m@kud.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kud/duux.git"
  },
  "homepage": "https://github.com/kud/duux#readme",
  "bugs": {
    "url": "https://github.com/kud/duux/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "mqtt": "5.15.2"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
